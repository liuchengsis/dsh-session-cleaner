{
  "name": "dsh-session-cleaner",
  "version": "2.0.0",
  "description": "Delete DeepSeek Harness sessions from the running web runtime: a real sidebar menu item plus a host route that removes the live entry, the workspace membership, and the on-disk artifacts.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs",
    "check": "node --check lib/index.js && node --check client.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "session",
    "delete"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuchengsis/dsh-session-cleaner.git"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
